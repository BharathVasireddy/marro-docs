              "api-reference/leads/add-note"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "api-reference/reference/list-fields",
              "api-reference/reference/list-stages",
              "api-reference/reference/list-pipelines",
              "api-reference/reference/list-sources",
              "api-reference/reference/list-users"
            ]
          }
        ]
      }
    ]
  }
