        "javascript",
        "php",
        "python"
      ]
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "getting-started",
              "authentication",
              "keys-and-scopes"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/connect-a-website",
              "guides/filtering"
