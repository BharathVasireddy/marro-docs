          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Leads",
            "pages": [
              "api-reference/leads/list-leads",
              "api-reference/leads/create-lead",
              "api-reference/leads/capture-lead",
