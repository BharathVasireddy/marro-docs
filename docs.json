{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Marro",
  "description": "How to connect to and use Marro.",
  "colors": {
    "primary": "#008450",
    "light": "#3DBE8B",
    "dark": "#006B41"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Plus Jakarta Sans"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open Marro",
      "href": "https://app.marro.si"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
